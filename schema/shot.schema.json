{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sbd:schema:0.3:shot",
  "title": "SBD shots/<id>.json",
  "description": "One shot: fields, duration and visual variants. Its script lines and position live in ids.json.",
  "type": "object",
  "required": ["id"],
  "properties": {
    "id": {
      "$ref": "#/$defs/id",
      "description": "Must equal the file name without .json."
    },
    "title": {
      "type": "string"
    },
    "fields": {
      "type": "object",
      "description": "Field values keyed by field id (see manifest shot_fields). Unknown keys are allowed (custom fields).",
      "additionalProperties": {
        "type": ["string", "number", "boolean", "null"]
      }
    },
    "duration": {
      "type": "number",
      "exclusiveMinimum": 0,
      "description": "Seconds. Omit to derive from lines and cues."
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "variants": {
      "type": "array",
      "description": "Alternative visuals for the shot (e.g. sketch, render, alternate framing).",
      "items": {
        "$ref": "#/$defs/variant"
      }
    },
    "active_variant": {
      "type": ["string", "null"],
      "description": "ID of the variant shown by default. Defaults to the first variant."
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
    },
    "variant": {
      "type": "object",
      "required": ["id", "type"],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "type": {
          "enum": ["image", "canvas"]
        },
        "name": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "image"
              }
            },
            "required": ["type"]
          },
          "then": {
            "$ref": "#/$defs/imageVariant"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "canvas"
              }
            },
            "required": ["type"]
          },
          "then": {
            "$ref": "#/$defs/canvasVariant"
          }
        }
      ]
    },
    "imageVariant": {
      "type": "object",
      "required": ["type", "asset"],
      "properties": {
        "type": {
          "const": "image"
        },
        "asset": {
          "$ref": "#/$defs/id",
          "description": "ID of an image (or video) asset."
        }
      }
    },
    "canvasVariant": {
      "type": "object",
      "required": ["type", "layers"],
      "properties": {
        "type": {
          "const": "canvas"
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "background": {
          "type": "string",
          "description": "CSS color. Default transparent."
        },
        "preview": {
          "$ref": "#/$defs/id",
          "description": "Optional image asset holding a flattened render of the composition."
        },
        "layers": {
          "type": "array",
          "description": "Bottom to top (array order is z-order).",
          "items": {
            "$ref": "#/$defs/layer"
          }
        }
      }
    },
    "layer": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "type": "string",
          "description": "image (default), text or slot (format 0.3). Readers ignore layers of kinds they do not know."
        },
        "asset": {
          "$ref": "#/$defs/id",
          "description": "Image layers: ID of an image (or video) asset."
        },
        "name": {
          "type": "string"
        },
        "x": {
          "type": "number",
          "description": "Canvas px of the layer origin (top-left before rotation). Default 0."
        },
        "y": {
          "type": "number",
          "description": "Default 0."
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Unscaled display width. Image: default crop width or asset width. Text: the wrap width. Slot: required."
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "scale_x": {
          "type": "number",
          "description": "Default 1. Negative flips."
        },
        "scale_y": {
          "type": "number",
          "description": "Default 1. Negative flips."
        },
        "rotation": {
          "type": "number",
          "description": "Degrees clockwise around the origin. Default 0."
        },
        "opacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Default 1."
        },
        "crop": {
          "type": "object",
          "description": "Source rectangle in asset pixels.",
          "required": ["x", "y", "width", "height"],
          "properties": {
            "x": {
              "type": "number",
              "minimum": 0
            },
            "y": {
              "type": "number",
              "minimum": 0
            },
            "width": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "height": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        },
        "filters": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["type"],
            "properties": {
              "type": {
                "type": "string",
                "description": "blur (px), brightness, contrast, saturate (1 = unchanged), grayscale, sepia, invert (0..1), hue_rotate (deg). CSS filter semantics."
              },
              "value": {
                "type": "number"
              }
            }
          }
        },
        "visible": {
          "type": "boolean",
          "description": "Default true."
        },
        "locked": {
          "type": "boolean",
          "description": "Editor hint. Default false."
        },
        "group": {
          "$ref": "#/$defs/id",
          "description": "Format 0.3: layers with the same group ID belong together (selected, moved and duplicated as one)."
        },
        "slot": {
          "type": "object",
          "description": "Format 0.3, image layers: the layout slot this image was fitted into (x, y, width, height in canvas px). The layer's own position/size/crop already place the image.",
          "required": ["x", "y", "width", "height"],
          "properties": {
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            },
            "width": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "height": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "fit": {
              "$ref": "#/$defs/fit"
            },
            "name": {
              "type": "string"
            }
          }
        },
        "fit": {
          "$ref": "#/$defs/fit",
          "description": "Slot layers: how an image dropped into the slot is fitted. Default cover."
        },
        "text": {
          "type": "string",
          "description": "Text layers: the text (\\n starts a new line; long lines wrap at width)."
        },
        "font": {
          "type": "string",
          "description": "Text layers: font family name (e.g. Montserrat, IBM Plex Sans, Courier Prime). Default IBM Plex Sans."
        },
        "font_asset": {
          "$ref": "#/$defs/id",
          "description": "Text layers: a font asset to use instead of font."
        },
        "font_size": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Text layers: canvas px. Default 64."
        },
        "font_weight": {
          "type": "number",
          "minimum": 1,
          "maximum": 1000,
          "description": "Text layers: 100–900. Default 400."
        },
        "italic": {
          "type": "boolean"
        },
        "uppercase": {
          "type": "boolean",
          "description": "Text layers: draw in capitals."
        },
        "color": {
          "type": "string",
          "description": "Text layers: CSS color. Default #ffffff."
        },
        "align": {
          "enum": ["left", "center", "right"],
          "description": "Text layers. Default center."
        },
        "line_height": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Text layers: multiple of font_size. Default 1.2."
        },
        "stroke": {
          "type": "object",
          "description": "Text layers: outline.",
          "required": ["color", "width"],
          "properties": {
            "color": {
              "type": "string"
            },
            "width": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        "shadow": {
          "type": "object",
          "description": "Text layers: drop shadow.",
          "required": ["color"],
          "properties": {
            "color": {
              "type": "string"
            },
            "blur": {
              "type": "number",
              "minimum": 0
            },
            "offset_x": {
              "type": "number"
            },
            "offset_y": {
              "type": "number"
            }
          }
        },
        "box": {
          "type": "object",
          "description": "Text layers: a box behind each line (boxed captions).",
          "required": ["color"],
          "properties": {
            "color": {
              "type": "string"
            },
            "padding": {
              "type": "number",
              "minimum": 0
            },
            "radius": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        "style": {
          "type": "string",
          "description": "Text layers: the caption style it was made from (bold, boxed, lower-third, title…); informational."
        }
      },
      "description": "A canvas layer. kind omitted or \"image\": an image/video asset. Format 0.3 adds \"text\" (on-screen text) and \"slot\" (an empty, named placeholder from a layout; not drawn in finished frames).",
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "text"
              }
            },
            "required": ["kind"]
          },
          "then": {
            "required": ["text"]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "slot"
              }
            },
            "required": ["kind"]
          },
          "then": {
            "required": ["width", "height"]
          }
        },
        {
          "if": {
            "anyOf": [
              {
                "not": {
                  "required": ["kind"]
                }
              },
              {
                "properties": {
                  "kind": {
                    "const": "image"
                  }
                },
                "required": ["kind"]
              }
            ]
          },
          "then": {
            "required": ["asset"]
          }
        }
      ]
    },
    "fit": {
      "enum": ["cover", "contain"]
    }
  }
}
