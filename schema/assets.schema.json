{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sbd:schema:0.2:assets",
  "title": "SBD assets.json",
  "description": "Registry of images, audio, video and fonts used by the storyboard.",
  "type": "object",
  "required": ["assets"],
  "properties": {
    "assets": { "type": "array", "items": { "$ref": "#/$defs/asset" } }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$" },
    "src": {
      "type": "string",
      "description": "media/<path> (embedded), file:<path> (linked, relative to the directory containing the .sbd), or http(s):// URL (incl. .m3u8).",
      "anyOf": [
        { "pattern": "^(?!.*(?:^|/)\\.\\.?(?:/|$))media/[^\\\\]+$" },
        { "pattern": "^file:.+" },
        { "pattern": "^https?://.+" }
      ]
    },
    "asset": {
      "type": "object",
      "required": ["id", "name", "kind", "src"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string" },
        "kind": { "enum": ["image", "audio", "video", "font"] },
        "category": { "type": "string", "description": "Category id (see manifest categories)." },
        "tags": { "type": "array", "items": { "type": "string" } },
        "src": { "$ref": "#/$defs/src" },
        "mime": { "type": "string" },
        "duration": { "type": "number", "minimum": 0, "description": "Seconds (audio/video)." },
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "height": { "type": "number", "exclusiveMinimum": 0 },
        "poster": { "$ref": "#/$defs/src", "description": "Still image for a video." },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "size": { "type": "integer", "minimum": 0, "description": "Bytes." },
        "variants": {
          "type": "array",
          "description": "Alternative renditions of the same asset (other codec, resolution, proxy, thumbnail).",
          "items": {
            "type": "object",
            "required": ["src"],
            "properties": {
              "src": { "$ref": "#/$defs/src" },
              "mime": { "type": "string" },
              "width": { "type": "number", "exclusiveMinimum": 0 },
              "height": { "type": "number", "exclusiveMinimum": 0 },
              "label": { "type": "string" },
              "role": { "type": "string", "description": "alt, proxy, thumbnail (free text)." }
            }
          }
        },
        "notes": { "type": "string" },
        "credit": { "type": "string" },
        "license": { "type": "string" }
      }
    }
  }
}
