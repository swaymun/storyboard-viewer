{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sbd:schema:0.3:manifest",
  "title": "SBD manifest.json",
  "description": "Project metadata, preset, frame settings, asset categories and shot field definitions. Readers must ignore unknown properties.",
  "type": "object",
  "required": ["format", "format_version", "title"],
  "properties": {
    "format": { "const": "sbd", "description": "Always \"sbd\"." },
    "format_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:[-+][0-9A-Za-z.-]+)?$",
      "description": "Semver of the SBD spec the file was written for, e.g. \"0.1.0\"."
    },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "authors": { "type": "array", "items": { "type": "string" } },
    "language": {
      "type": "string",
      "description": "BCP 47 language tag of the script, e.g. \"en\"."
    },
    "preset": {
      "type": "string",
      "description": "Preset the project was created from: blank, film, documentary, animation, motion, vertical (or any other string)."
    },
    "aspect_ratio": {
      "type": "string",
      "pattern": "^\\d+(?:\\.\\d+)?:\\d+(?:\\.\\d+)?$",
      "description": "Frame aspect ratio, e.g. \"16:9\", \"2.39:1\", \"9:16\". Default \"16:9\"."
    },
    "canvas": {
      "type": "object",
      "description": "Default canvas size in pixels for canvas variants. Default 1920x1080.",
      "required": ["width", "height"],
      "properties": {
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "height": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "fps": {
      "type": "number",
      "exclusiveMinimum": 0,
      "description": "Frames per second. Default 24."
    },
    "default_shot_duration": {
      "type": "number",
      "exclusiveMinimum": 0,
      "description": "Seconds used for a shot without duration, lines or cues. Default 3."
    },
    "categories": {
      "type": "array",
      "description": "Asset categories offered by the UI. Assets may still use categories not listed here.",
      "items": {
        "type": "object",
        "required": ["id", "label"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "label": { "type": "string" },
          "kinds": {
            "type": "array",
            "items": { "enum": ["image", "audio", "video", "font"] },
            "description": "Asset kinds this category is meant for (a UI hint)."
          },
          "color": { "type": "string" }
        }
      }
    },
    "shot_fields": {
      "type": "array",
      "description": "Field definitions shown for every shot (values live in shots/<id>.json `fields`).",
      "items": {
        "type": "object",
        "required": ["id", "label"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "label": { "type": "string" },
          "type": {
            "enum": ["text", "longtext", "number", "boolean", "select"],
            "description": "Default \"text\"."
          },
          "options": { "type": "array", "items": { "type": "string" } },
          "placeholder": { "type": "string" },
          "description": { "type": "string" }
        }
      }
    },
    "created": { "type": "string" },
    "modified": { "type": "string" },
    "generator": { "type": "string" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$" }
  }
}
